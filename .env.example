# Node 22+ recommended. Copy this file to .env; never put keys in VITE_ variables.
API_PORT=3001
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173
# OpenAI-compatible provider. Example: https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# Your Judge0 CE deployment or compatible hosted API (without /submissions).
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=
REMOVE_BG_API_KEY=

# Public origin only; not a secret. Set when deploying.
VITE_SITE_URL=
