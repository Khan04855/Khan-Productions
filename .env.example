# Copy to .env in the SAME folder as package.json. Never commit .env.
# Node 22.12+ or a compatible newer version.
API_PORT=3001
# On production hosting set API_HOST=0.0.0.0. PORT may be assigned by the host.
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,http://127.0.0.1:3001

AI_PROVIDER=gemini
GEMINI_API_KEY=
# Use an exact model ID enabled for your AI Studio project. Verify before launch.
GEMINI_MODEL=
# Optional alternative provider: set AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# URL of your own or hosted Judge0 CE service, without /submissions.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_AUTH_TOKEN=
# Match /languages on your Judge0 installation; IDs vary by deployment.
JUDGE0_LANGUAGE_PYTHON=71
JUDGE0_LANGUAGE_JAVASCRIPT=63
JUDGE0_LANGUAGE_C=50
JUDGE0_LANGUAGE_CPP=54
JUDGE0_LANGUAGE_JAVA=62

# Browser background removal needs no key.
# Public deployment origin (no trailing slash); used for SEO.
VITE_SITE_URL=
# Leave blank for same-origin deployment. Separate backend: https://api.example.com
# Public URL only. NEVER put keys in VITE_ variables.
VITE_API_BASE_URL=
